# Copy to .env and fill in real values. Never commit .env or real keys.
# This adapter's read/prepare path never handles keys at all; it only
# prepares transactions for a wallet to sign.
#
# Variables are named SILICA_*.

SILICA_NEAR_NETWORK=testnet
SILICA_NEAR_RPC_URL=https://test.rpc.fastnear.com

# DEV-MARKET MODE: until the contract is deployed, leave the two IDs
# below empty (or set SILICA_NEAR_DEV_MARKET=true) and the adapter serves a
# synthetic market so the whole stack runs without a deployment. Set
# SILICA_NEAR_DEV_MARKET=false once deployed to make missing IDs a hard
# error again.
SILICA_NEAR_DEV_MARKET=

# The deployed Silica contract account.
SILICA_NEAR_CONTRACT_ID=

# The NEP-141 collateral token account (tUSDC, 6 decimals).
SILICA_NEAR_COLLATERAL_TOKEN=