# Copy to .env and fill in real values. Never commit .env or real keys.
# This server itself never holds any private key (only the cron tick's
# publisher key, set in the deployment environment) - see
# blockchain/near/.env.example for the NEAR adapter's own env file, which
# this server also needs filled in (reads and transaction preparation only;
# wallets sign).
# On startup the server loads ./.env and ../blockchain/near/.env (each
# optional) into the process environment - see src/index.ts.
#
# Variables are named SILICA_*. The original GASX_* names still work as a
# fallback (SILICA_* wins when both are set). CRON_SECRET keeps its name.
# NEAR account ids keep the project's original name (gasx.testnet, ...).
#
# Until the Silica contract is deployed, leave blockchain/near's IDs empty:
# the NEAR adapter's dev-market mode serves a synthetic market so this
# whole stack runs locally.

SILICA_API_PORT=3000

# Hard risk policy constants. Defaults are reasonable for a demo; override
# for a different budget.
SILICA_API_MAX_ORDER_CONTRACTS=100
SILICA_API_MAX_POSITION_CONTRACTS=500
# 0 disables this check entirely. Deliberately off by default for
# frictionless testnet trading -- set a positive value (e.g. 100 = 1%)
# to re-enable protection against pricing an order far from the oracle.
SILICA_API_MAX_SLIPPAGE_BPS=0

# Postgres (Supabase) durable state, see supabase/migrations. Optional -
# leave unset and the server runs statelessly, which keeps the dev-market
# path working with no database at all.
SILICA_API_DATABASE_URL=

# Optional Ethereum JSON-RPC URL for the blockspace pillar
# (default https://ethereum-rpc.publicnode.com).
SILICA_ETH_RPC_URL=

# Cron tick (POST/GET /api/v1/cron/tick) bearer secret. Unset = route refuses.
CRON_SECRET=

# Groq API key for the platform-explainer chat assistant
# (POST /api/v1/chat). Undefined disables the route (501) rather than
# degrading silently. Get a key at https://console.groq.com.
SILICA_API_GROQ_API_KEY=
# llama-3.3-70b-versatile was deprecated by Groq in 2026-07; the current
# recommended models are the openai/gpt-oss family. gpt-oss-20b is the
# smaller, faster one -- plenty for a chat widget answering questions
# about the platform.
SILICA_API_GROQ_MODEL=openai/gpt-oss-20b