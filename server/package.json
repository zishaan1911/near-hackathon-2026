{
  "name": "@silica/server",
  "version": "0.1.0",
  "private": true,
  "description": "Silica API server: REST endpoints for the Silica Compute Index and the SCI-1H market, plus order/account transaction preparation on NEAR with a hard risk policy.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "build:vercel": "esbuild src/vercelHandler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=../api/index.js --footer:js=\"module.exports = module.exports.default;\"",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build:adapters": "npm --prefix ../blockchain/near run build",
    "predev": "npm run build:adapters",
    "prebuild": "npm run build:adapters"
  },
  "dependencies": {
    "@silica/near-adapter": "file:../blockchain/near",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
