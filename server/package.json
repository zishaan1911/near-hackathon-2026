{
  "name": "@gasx/api",
  "version": "0.1.0",
  "private": true,
  "description": "GASX API gateway (ARCHITECTURE.md §2, §9): REST endpoints for market state, order/account transaction preparation on NEAR. Enforces ARCHITECTURE.md §8's hard risk policy on order preparation.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build:adapters": "npm --prefix ../blockchain/near run build",
    "predev": "npm run build:adapters",
    "prebuild": "npm run build:adapters"
  },
  "dependencies": {
    "@gasx/near-adapter": "file:../blockchain/near",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
