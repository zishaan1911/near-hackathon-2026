# Copy to .env and fill in real values. Never commit .env or real keys
# (GLOSSARY.md's Golden Rules). This gateway itself never holds any
# private key — see blockchain/near/.env.example for the NEAR adapter's
# own env file, which this gateway also needs filled in (reads and
# transaction preparation only; wallets sign).
# On startup the gateway loads ./.env and ../blockchain/near/.env (each
# optional) into the process environment — see src/index.ts.
#
# Until the gasx contract is deployed, leave blockchain/near's IDs empty:
# the NEAR adapter's dev-market mode serves a synthetic market so this
# whole stack runs locally.

GASX_API_PORT=3000

# Base URL of the Python AI service (ai/main.py). Run it separately —
# see ai/README.md.
GASX_API_AI_SERVICE_URL=http://localhost:8000

# ARCHITECTURE.md §8's Hard Risk Policy constants. Defaults are
# reasonable for a demo; override for a different budget.
GASX_API_MAX_ORDER_CONTRACTS=100
GASX_API_MAX_POSITION_CONTRACTS=500
# 0 disables this check entirely. Deliberately off by default for
# frictionless testnet trading -- set a positive value (e.g. 100 = 1%)
# to re-enable protection against pricing an order far from the oracle.
GASX_API_MAX_SLIPPAGE_BPS=0
GASX_API_MIN_MODEL_CONFIDENCE_PCT=70
GASX_API_MAX_HEDGE_NOTIONAL=1000

# MySQL durable state (database/README.md). Optional — leave unset and
# the gateway runs statelessly, which keeps the dev-market path working
# with no MySQL install at all.
GASX_API_DATABASE_URL=mysql://gasx:gasx@localhost:3306/gasx

# Groq API key for the platform-explainer chat assistant
# (POST /api/v1/chat). Undefined disables the route (501) rather than
# degrading silently. Get a key at https://console.groq.com.
GASX_API_GROQ_API_KEY=
# llama-3.3-70b-versatile was deprecated by Groq in 2026-07; the current
# recommended models are the openai/gpt-oss family. gpt-oss-20b is the
# smaller, faster one -- plenty for a chat widget answering questions
# about the platform.
GASX_API_GROQ_MODEL=openai/gpt-oss-20b
