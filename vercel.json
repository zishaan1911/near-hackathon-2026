{
  "version": 2,
  "framework": null,
  "buildCommand": "npm --prefix blockchain/near ci && npm --prefix blockchain/near run build && npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo skip",
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/v1/cron/tick", "schedule": "0 0 * * *" }],
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
