# Copy to .env and fill in. Never commit real keys.
#
# Variables are named SILICA_*. The original GASX_* names still work as a
# fallback (SILICA_* wins when both are set). CRON_SECRET and VITE_* keep
# their names.
#
# NEAR account ids keep the project's original name (gasx.testnet,
# tusdc.gasx.testnet, oracle.gasx.testnet, ...): they are on-chain and cannot
# be renamed.

# --- Chain (server + web) ---
SILICA_NEAR_NETWORK=testnet
SILICA_NEAR_RPC_URL=https://test.rpc.fastnear.com
SILICA_NEAR_CONTRACT_ID=silica.your-account.testnet
SILICA_NEAR_COLLATERAL_TOKEN=tusdc.your-account.testnet
# "true" serves a synthetic market and needs no deployed contract.
SILICA_NEAR_DEV_MARKET=true

# --- Cron tick signer (publishes the index, settles, rolls, matches) ---
SILICA_NEAR_PUBLISHER_ACCOUNT_ID=publisher.your-account.testnet
SILICA_NEAR_PUBLISHER_PRIVATE_KEY=ed25519:REPLACE_ME

# --- Demo liquidity (testnet demo only) ---
# When 'true', the cron tick quotes a bid and an ask (SCI-1H) around the oracle
# price from the publisher account so a 1-contract order can fill. The maker is
# the ORACLE account: the price setter trading against users is a conflict of
# interest, acceptable only for a testnet demo. Never enable on mainnet.
# Needs SILICA_NEAR_PUBLISHER_ACCOUNT_ID funded with collateral in the contract.
SILICA_DEMO_LIQUIDITY=false
# On-chain units per quote. 100 units = 1.00 contract in the app. Only equal
# quantities match, so 100 fills 1-contract orders.
SILICA_DEMO_LIQUIDITY_QUANTITY=100

# --- Deploy script (scripts/deploy-near.sh) ---
NEAR_NETWORK=testnet
OWNER_ID=your-account.testnet
CONTRACT_ID=silica.your-account.testnet
TOKEN_ID=tusdc.your-account.testnet
PUBLISHER_ID=publisher.your-account.testnet
DEPLOY_MOCK_TOKEN=true

# --- Vercel / Supabase deployment (placeholders only) ---
# Shared secret for /api/v1/cron/tick; must match app.settings.cron_secret
# in Supabase (see supabase/migrations/0002_cron.sql).
CRON_SECRET=REPLACE_ME
# Supabase pooler connection string
SILICA_API_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SILICA_API_GROQ_API_KEY=REPLACE_ME
# Optional Ethereum JSON-RPC URL for the blockspace pillar.
SILICA_ETH_RPC_URL=
VITE_NEAR_NETWORK=testnet
VITE_NEAR_CONTRACT_ID=silica.your-account.testnet
VITE_NEAR_COLLATERAL_TOKEN=tusdc.your-account.testnet