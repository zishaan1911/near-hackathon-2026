# Copy to .env and fill in. Never commit real keys.

# --- Chain (api + web) ---
GASX_NEAR_NETWORK=testnet
GASX_NEAR_RPC_URL=https://test.rpc.fastnear.com
GASX_NEAR_CONTRACT_ID=gasx.your-account.testnet
GASX_NEAR_COLLATERAL_TOKEN=tusdc.your-account.testnet
# "true" serves a synthetic market and needs no deployed contract.
GASX_NEAR_DEV_MARKET=true

# --- Oracle publisher (docker compose --profile live) ---
GASX_NEAR_PUBLISHER_ACCOUNT_ID=publisher.your-account.testnet
GASX_NEAR_PUBLISHER_PRIVATE_KEY=ed25519:REPLACE_ME
# Gateway base URL the publisher reads /api/v1/indices/compute from.
GASX_PUBLISH_API_URL=http://api:3000
GASX_PUBLISH_INTERVAL_SECONDS=60

# --- Order matcher (docker compose --profile live) ---
GASX_NEAR_MATCHER_ACCOUNT_ID=matcher.your-account.testnet
GASX_NEAR_MATCHER_PRIVATE_KEY=ed25519:REPLACE_ME
GASX_MATCH_INTERVAL_SECONDS=5

# --- Liquidity seeder (npm --prefix blockchain/near run seed) ---
GASX_NEAR_SEED_ACCOUNT_ID=seeder.your-account.testnet
GASX_NEAR_SEED_PRIVATE_KEY=ed25519:REPLACE_ME
GASX_SEED_LEVELS=3
GASX_SEED_QUANTITY=100
GASX_SEED_INTERVAL_SECONDS=300

# --- Deploy script (scripts/deploy-near.sh) ---
NEAR_NETWORK=testnet
OWNER_ID=your-account.testnet
CONTRACT_ID=gasx.your-account.testnet
TOKEN_ID=tusdc.your-account.testnet
PUBLISHER_ID=publisher.your-account.testnet
MATCHER_ID=matcher.your-account.testnet
DEPLOY_MOCK_TOKEN=true

# --- Vercel / Supabase deployment (placeholders only) ---
# Shared secret for /api/v1/cron/tick; must match app.settings.cron_secret
# in Supabase (see supabase/migrations/0002_cron.sql).
CRON_SECRET=REPLACE_ME
GASX_NEAR_PUBLISHER_ACCOUNT_ID=publisher.your-account.testnet
GASX_NEAR_PUBLISHER_PRIVATE_KEY=ed25519:REPLACE_ME
# Supabase pooler connection string
GASX_API_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
GASX_API_GROQ_API_KEY=REPLACE_ME
VITE_NEAR_NETWORK=testnet
VITE_NEAR_CONTRACT_ID=gasx.your-account.testnet
VITE_NEAR_COLLATERAL_TOKEN=tusdc.your-account.testnet
